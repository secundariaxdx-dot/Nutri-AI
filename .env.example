# Todas las variables son OPCIONALES. La app funciona sin ellas.

# Sincronización multidispositivo con Supabase (plan gratuito).
# La "anon key" es pública por diseño (la seguridad la aplica RLS). NUNCA uses la service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave gratuita de api.data.gov para USDA FoodData Central (sin tarjeta).
# Si se deja vacía se usa DEMO_KEY (muy limitada).
VITE_USDA_API_KEY=

# Ruta base del despliegue. En GitHub Pages la configura el workflow automáticamente.
# VITE_BASE=/Nutri-AI/
